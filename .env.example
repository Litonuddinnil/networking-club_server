# Copy this file to server/.env and fill in real values.
# Never commit the populated server/.env to source control.

# MongoDB connection string. Atlas example:
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_URI=

# DeepSeek API key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Express port (default 5000)
PORT=5000

# "production" enables static file serving from client/dist
NODE_ENV=development

# Comma-separated list of allowed origins for CORS in production.
# Example: https://your-app.vercel.app,https://your-domain.com
CORS_ORIGIN=

# Optional shared secret to gate /api/diagnose-network.
# If set, every request must send `x-ai-key: <value>`.
AI_GATEWAY_KEY=